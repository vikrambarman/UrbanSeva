generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════
// ENUMS
// ═══════════════════════════════

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
  SUPER_ADMIN
  CALLING_TEAM    // ← Ops portal ke liye calling team members
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum PriceType {
  FIXED
  STARTING_AT
  PER_SQFT
  CUSTOM_QUOTE
}

enum ProviderStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

// ═══════════════════════════════
// BOOKING STATUS - PRODUCTION FLOW
// ═══════════════════════════════
// KYA: Complete booking lifecycle with verification workflow
// KYUN: Real production flow - payment ke baad OPS verify karega,
//       phir provider assign hoga, tab customer ko confirmation milega
// NOTE: Legacy statuses (PENDING, CONFIRMED) rakhe hain backward compatibility ke liye
enum BookingStatus {
  // Legacy statuses (keep for backward compatibility)
  PENDING
  CONFIRMED
  
  // New Production Flow - Customer Journey
  PAYMENT_RECEIVED      // Payment done, waiting OPS verification
  PENDING_CONFIRMATION  // OPS verifying slot & provider availability
  
  // Confirmation Flow
  RESCHEDULE_PENDING    // OPS proposed new slot, waiting customer OTP
  
  // Service Execution (existing)
  PROVIDER_ASSIGNED
  PROVIDER_TRAVELLING
  SERVICE_STARTED
  SERVICE_COMPLETED
  
  // Terminal States (existing)
  CANCELLED
  REFUND_INITIATED
  REFUNDED
  
  // New Terminal States - Granular cancellation tracking
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_OPS
  CANCELLED_BY_PROVIDER
  NO_SHOW
  FAILED
}

// ═══════════════════════════════
// PROVIDER WORK STATUS - REAL-TIME TRACKING
// ═══════════════════════════════
// KYA: Provider ka current real-time status
// KYUN: OPS team ko pata hona chahiye ki provider available hai ya busy
//       Agar provider WORKING hai, toh OPS ko warning milegi before assigning
enum ProviderWorkStatus {
  AVAILABLE     // Free, can take new jobs
  ON_THE_WAY    // Going to customer location
  WORKING       // Currently servicing customer
  ON_BREAK      // Temporary break (30 mins max)
  OFFLINE       // Not available for jobs
}

// ═══════════════════════════════
// RESCHEDULE STATUS - OTP CONFIRMATION
// ═══════════════════════════════
// KYA: Reschedule request ka status
// KYUN: OPS ne naya slot propose kiya, customer ko OTP se confirm karna hai
enum RescheduleStatus {
  PENDING    // Waiting for customer OTP
  CONFIRMED  // Customer confirmed via OTP
  REJECTED   // Customer rejected or OTP expired
  CANCELLED  // OPS cancelled the request
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUND_INITIATED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum WalletTxnType {
  CREDIT
  DEBIT
  REFUND
  REFERRAL_BONUS
  CASHBACK
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum EarningStatus {
  PENDING
  PENDING_VERIFICATION  // NEW: COD needs OPS verification
  SETTLED
  PAYOUT_INITIATED
  PAID
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_ASSIGNED
  PROVIDER_TRAVELLING
  SERVICE_STARTED
  SERVICE_COMPLETED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  REVIEW_REQUEST
  OFFER
  GENERAL
  // New notification types
  BOOKING_RECEIVED          // Payment done, waiting confirmation
  RESCHEDULE_REQUESTED      // OPS proposed new slot
  PROVIDER_ON_THE_WAY       // Provider going to location
}

enum PropertyType {
  SINGLE_ROOM
  ONE_RK
  ONE_BHK
  TWO_RK
  TWO_BHK
  THREE_RK
  THREE_BHK
  INDEPENDENT_HOUSE
  BUNGALOW
  SHOP
  OFFICE
  SHOWROOM
  GODOWN
  PLOT
  AGRICULTURAL_LAND
}

enum ListingType {
  RENT
  SALE
}

enum FurnishedType {
  FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
}

enum PropertyStatus {
  ACTIVE
  RENTED
  SOLD
  EXPIRED
  INACTIVE
}

enum ConnectionType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  NOT_INTERESTED
  REGISTERED
  FOLLOW_UP
}

// ═══════════════════════════════
// AUTH MODELS
// ═══════════════════════════════

model User {
  id            String      @id @default(cuid())
  phone         String      @unique
  name          String?
  email         String?
  password      String?
  avatar        String?
  role          Role        @default(CUSTOMER)
  isActive      Boolean     @default(true)
  isVerified    Boolean     @default(false)
  fcmToken      String?
  referralCode  String      @unique @default(cuid())
  referredBy    String?
  walletBalance Float       @default(0)
  loyaltyPoints Int         @default(0)
  loyaltyTier   LoyaltyTier @default(BRONZE)
  
  // Login tracking
  lastLoginAt   DateTime?
  loginCount    Int         @default(0)
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  // Relations
  bookings      Booking[]
  reviews       Review[]
  addresses     Address[]
  walletTxns    WalletTransaction[]
  notifications Notification[]
  provider      Provider?
  properties    Property[]
  subscriptions UserSubscription[]
  
  // Calling Team Portal
  staffCategories      StaffCategory[]        @relation("StaffCategories")
  assignedCategories   StaffCategory[]        @relation("StaffCategoryAssignedBy")
  assignmentLogs       BookingAssignmentLog[] @relation("AssignmentLogs")
}

model OTPVerification {
  id        String   @id @default(cuid())
  phone     String
  otp       String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ═══════════════════════════════
// ADDRESS MODEL
// ═══════════════════════════════

model Address {
  id          String    @id @default(cuid())
  userId      String
  label       String
  fullAddress String
  area        String
  landmark    String?
  pincode     String
  latitude    Float?
  longitude   Float?
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([userId])
}

// ═══════════════════════════════
// SERVICE MODELS
// ═══════════════════════════════

model Category {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  image         String?
  icon          String?
  description   String?
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())

  subCategories SubCategory[]
  staffCategories StaffCategory[]
}

model SubCategory {
  id          String    @id @default(cuid())
  categoryId  String
  name        String
  slug        String    @unique
  image       String?
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  services Service[]

  @@index([categoryId])
}

model Service {
  id            String    @id @default(cuid())
  subCategoryId String
  name          String
  slug          String    @unique
  description   String
  image         String?
  basePrice     Float
  priceType     PriceType @default(FIXED)
  duration      String
  professionals Int       @default(1)
  guarantee     String?
  isActive      Boolean   @default(true)
  isTrending    Boolean   @default(false)
  isFeatured    Boolean   @default(false)
  sortOrder     Int       @default(0)
  avgRating     Float     @default(0)
  totalReviews  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subCategory  SubCategory        @relation(fields: [subCategoryId], references: [id])
  inclusions   ServiceInclusion[]
  exclusions   ServiceExclusion[]
  pricingTiers ServicePricing[]
  addOns       ServiceAddOn[]
  bookings     Booking[]
  reviews      Review[]
  faqs         ServiceFAQ[]
  providerServices ProviderService[]

  @@index([subCategoryId])
  @@index([isTrending])
  @@index([isFeatured])
}

model ServiceInclusion {
  id        String  @id @default(cuid())
  serviceId String
  text      String
  sortOrder Int     @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@unique([serviceId, text])
}

model ServiceExclusion {
  id        String  @id @default(cuid())
  serviceId String
  text      String
  sortOrder Int     @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, text])
}

model ServicePricing {
  id        String  @id @default(cuid())
  serviceId String
  label     String
  price     Float
  duration  String?
  sortOrder Int     @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServiceAddOn {
  id          String  @id @default(cuid())
  serviceId   String
  name        String
  price       Float
  description String?

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, name])
}

model ServiceFAQ {
  id        String  @id @default(cuid())
  serviceId String
  question  String
  answer    String
  sortOrder Int     @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, question])
}

// ═══════════════════════════════
// PROVIDER MODELS
// ═══════════════════════════════

model Provider {
  id              String             @id @default(cuid())
  userId          String             @unique
  bio             String?
  experience      Int                @default(0)
  aadharNumber    String?
  panNumber       String?
  aadharImage     String?
  panImage        String?
  policeVerified  Boolean            @default(false)
  portfolioImages String[]
  bankAccount     String?
  bankIFSC        String?
  bankName        String?
  upiId           String?
  commissionRate  Float              @default(20)
  status          ProviderStatus     @default(PENDING)
  avgRating       Float              @default(0)
  totalJobs       Int                @default(0)
  totalEarnings   Float              @default(0)
  isAvailable     Boolean            @default(false)
  serviceAreas    String[]
  
  // ═══════════════════════════════
  // NEW FIELDS - Real-time Status Tracking
  // ═══════════════════════════════
  // KYA: Provider ka current work status aur active job
  // KYUN: OPS team ko pata chalega ki provider available hai ya busy
  //       Agar WORKING hai toh warning dikhegi before assigning
  currentWorkStatus ProviderWorkStatus @default(AVAILABLE)
  currentJobId      String?            // Currently assigned booking ID
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user         User                   @relation(fields: [userId], references: [id])
  services     ProviderService[]
  bookings     Booking[]
  availability ProviderAvailability[]
  payouts      Payout[]
  earnings     ProviderEarning[]
}

model ProviderService {
  id          String   @id @default(cuid())
  providerId  String
  serviceId   String
  customPrice Float?
  isActive    Boolean  @default(true)
  assignedBy  String?
  assignedAt  DateTime @default(now())
  notes       String?

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([providerId, serviceId])
  @@index([serviceId])
  @@index([providerId])
}

model ProviderAvailability {
  id          String   @id @default(cuid())
  providerId  String
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Boolean  @default(true)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

// ═══════════════════════════════
// BOOKING MODELS
// ═══════════════════════════════

model Booking {
  id                  String        @id @default(cuid())
  bookingNumber       String        @unique
  userId              String
  providerId          String?
  serviceId           String
  addressId           String
  pricingLabel        String?
  addOns              Json?
  scheduledDate       DateTime
  scheduledTime       String
  status              BookingStatus @default(PENDING)
  baseAmount          Float
  addOnAmount         Float         @default(0)
  discountAmount      Float         @default(0)
  couponCode          String?
  totalAmount         Float
  paymentStatus       PaymentStatus @default(PENDING)
  paymentMethod       String?       // "ONLINE" | "COD"
  razorpayOrderId     String?
  razorpayPaymentId   String?
  startOTP            String?
  endOTP              String?
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  specialInstructions String?
  beforePhotos        String[]
  afterPhotos         String[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user          User                   @relation(fields: [userId], references: [id])
  provider      Provider?              @relation(fields: [providerId], references: [id])
  service       Service                @relation(fields: [serviceId], references: [id])
  address       Address                @relation(fields: [addressId], references: [id])
  review        Review?
  payment       Payment?
  statusHistory BookingStatusHistory[]
  assignmentLogs BookingAssignmentLog[]

  // ═══════════════════════════════
  // NEW FIELDS - COD Payment Tracking
  // ═══════════════════════════════
  codAmountCollected  Float?      // Provider ne kitna collect kiya
  codVerifiedBy       String?     // OPS ne verify kiya (user ID)
  codVerifiedAt       DateTime?   // Verification timestamp
  codDisputed         Boolean     @default(false)  // Amount disputed hai ya nahi
  
  // ═══════════════════════════════
  // NEW RELATION - Reschedule Requests
  // ═══════════════════════════════
  rescheduleRequests RescheduleRequest[]

  @@index([userId])
  @@index([providerId])
  @@index([status])
}

// ═══════════════════════════════
// RESCHEDULE REQUEST MODEL - OTP CONFIRMATION
// ═══════════════════════════════
// KYA: OPS ya customer ne reschedule request ki hai, OTP se confirm hoga
// KYUN: Security - customer ki permission ke bina booking reschedule nahi hogi
//       OTP valid for 10 minutes, max 3 attempts
model RescheduleRequest {
  id              String           @id @default(cuid())
  bookingId       String
  originalSlot    DateTime         // Purana scheduled time
  proposedSlot    DateTime         // Naya proposed time
  reason          String?          // Why rescheduling
  
  otp             String           // 4-digit OTP
  otpExpiresAt    DateTime         // OTP expiry (10 mins)
  otpAttempts     Int              @default(0) // Track failed attempts
  
  status          RescheduleStatus @default(PENDING)
  requestedBy     String           // "OPS" | "CUSTOMER" | "PROVIDER"
  
  confirmedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}

model BookingStatusHistory {
  id        String        @id @default(cuid())
  bookingId String
  status    BookingStatus
  note      String?
  changedBy String?
  createdAt DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// ═══════════════════════════════
// PAYMENT MODEL
// ═══════════════════════════════

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  amount            Float
  currency          String        @default("INR")
  method            String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  refundId          String?
  refundAmount      Float?
  refundedAt        DateTime?
  createdAt         DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
}

// ═══════════════════════════════
// WALLET MODEL
// ═══════════════════════════════

model WalletTransaction {
  id          String        @id @default(cuid())
  userId      String
  type        WalletTxnType
  amount      Float
  balance     Float
  description String
  referenceId String?
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ═══════════════════════════════
// REVIEW MODEL
// ═══════════════════════════════

model Review {
  id                String   @id @default(cuid())
  bookingId         String   @unique
  userId            String
  serviceId         String
  providerId        String?
  overallRating     Float
  punctualityRating Float?
  qualityRating     Float?
  behaviourRating   Float?
  valueRating       Float?
  comment           String?
  photos            String[]
  isVerified        Boolean  @default(true)
  providerReply     String?
  helpfulCount      Int      @default(0)
  createdAt         DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@index([serviceId])
  @@index([userId])
}

// ═══════════════════════════════
// COUPON MODEL
// ═══════════════════════════════

model Coupon {
  id                   String       @id @default(cuid())
  code                 String       @unique
  description          String
  discountType         DiscountType
  discountValue        Float
  minOrderAmount       Float        @default(0)
  maxDiscount          Float?
  usageLimit           Int?
  usedCount            Int          @default(0)
  perUserLimit         Int          @default(1)
  validFrom            DateTime
  validTill            DateTime
  isActive             Boolean      @default(true)
  applicableCategories String[]
  createdAt            DateTime     @default(now())
}

// ═══════════════════════════════
// PROVIDER EARNINGS
// ═══════════════════════════════

model ProviderEarning {
  id         String        @id @default(cuid())
  providerId String
  bookingId  String
  gross      Float
  commission Float
  net        Float
  status     EarningStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  provider Provider @relation(fields: [providerId], references: [id])

  @@index([providerId])
}

model Payout {
  id          String       @id @default(cuid())
  providerId  String
  amount      Float
  method      String
  status      PayoutStatus @default(PENDING)
  reference   String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())

  provider Provider @relation(fields: [providerId], references: [id])

  @@index([providerId])
}

// ═══════════════════════════════
// NOTIFICATION MODEL
// ═══════════════════════════════

model Notification {
  id          String           @id @default(cuid())
  userId      String
  title       String
  body        String
  type        NotificationType
  referenceId String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ═══════════════════════════════
// PROPERTY MODELS
// ═══════════════════════════════

model Property {
  id                String         @id @default(cuid())
  userId            String
  title             String
  description       String
  type              PropertyType
  listingType       ListingType
  price             Float
  priceNegotiable   Boolean        @default(true)
  area              Float?
  bedrooms          Int?
  bathrooms         Int?
  floor             Int?
  totalFloors       Int?
  furnished         FurnishedType  @default(UNFURNISHED)
  locality          String
  fullAddress       String
  landmark          String?
  latitude          Float?
  longitude         Float?
  images            String[]
  amenities         String[]
  isBachelorAllowed Boolean        @default(true)
  isPetAllowed      Boolean        @default(false)
  isVerified        Boolean        @default(false)
  isFeatured        Boolean        @default(false)
  status            PropertyStatus @default(ACTIVE)
  listingPlan       String         @default("BASIC")
  expiresAt         DateTime?
  viewCount         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([listingType])
}

// ═══════════════════════════════
// CSPDCL MODELS
// ═══════════════════════════════

model CSPDCLConsumer {
  id               String         @id @default(cuid())
  consumerNumber   String         @unique
  name             String
  address          String
  area             String
  locality         String?
  ward             String?
  connectionType   ConnectionType @default(RESIDENTIAL)
  contactNumber    String?
  loadSanctioned   Float?
  lastBillAmount   Float?
  paymentStatus    String?
  isRegistered     Boolean        @default(false)
  registeredUserId String?
  leadStatus       LeadStatus     @default(NEW)
  campaignId       String?
  lastContactedAt  DateTime?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  campaign CSPDCLCampaign? @relation(fields: [campaignId], references: [id])
  callLogs CSPDCLCallLog[]

  @@index([leadStatus])
  @@index([campaignId])
}

model CSPDCLCampaign {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdBy   String
  createdAt   DateTime @default(now())

  consumers CSPDCLConsumer[]
  callLogs  CSPDCLCallLog[]
}

model CSPDCLCallLog {
  id         String      @id @default(cuid())
  consumerId String
  campaignId String?
  calledBy   String
  status     String
  outcome    LeadStatus?
  notes      String?
  duration   Int?
  calledAt   DateTime    @default(now())

  consumer CSPDCLConsumer  @relation(fields: [consumerId], references: [id])
  campaign CSPDCLCampaign? @relation(fields: [campaignId], references: [id])

  @@index([consumerId])
}

// ═══════════════════════════════
// SUBSCRIPTION MODELS
// ═══════════════════════════════

model SubscriptionPlan {
  id            String   @id @default(cuid())
  name          String
  price         Float
  duration      Int
  discount      Float
  features      String[]
  isActive      Boolean  @default(true)

  subscriptions UserSubscription[]
}

model UserSubscription {
  id        String   @id @default(cuid())
  userId    String
  planId    String
  startDate DateTime @default(now())
  endDate   DateTime
  isActive  Boolean  @default(true)
  paymentId String?

  user User             @relation(fields: [userId], references: [id])
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId])
}

// ═══════════════════════════════
// CMS MODELS
// ═══════════════════════════════

model Banner {
  id        String    @id @default(cuid())
  title     String
  image     String
  link      String?
  position  String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
}

model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// ═══════════════════════════════
// GLOBAL FAQ MODEL
// ═══════════════════════════════

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ProviderInquiry {
  id         String   @id @default(cuid())
  name       String
  phone      String   @unique
  email      String?
  experience Int?
  services   String?
  city       String?
  message    String?  @db.Text
  status     String   @default("PENDING")
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

